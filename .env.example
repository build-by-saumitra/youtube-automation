# ─── LLM APIs ───────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── TTS (Kokoro is local — no key needed) ──────────────────────
# Optional premium fallback:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Stock Footage ───────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ─── YouTube Data API (OAuth 2.0) ────────────────────────────────
# Download credentials JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CHANNEL_ID=your_channel_id_here

# ─── Reddit (read-only app) ──────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=youtube-automation-bot/1.0

# ─── TTS Config ──────────────────────────────────────────────────
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.05

# ─── Pipeline Config ─────────────────────────────────────────────
OUTPUT_DIR=output
CACHE_DIR=cache
MUSIC_DIR=music
DB_PATH=data/db.sqlite3

# ─── Confidence Score ────────────────────────────────────────────
AUTO_APPROVE_THRESHOLD=0.80

# ─── Scheduling ──────────────────────────────────────────────────
IDEA_EXPLORER_INTERVAL_HOURS=6
ENABLE_AUTO_QUEUE=true

# ─── Server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
